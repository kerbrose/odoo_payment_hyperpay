<?xml version="1.0" encoding="utf-8"?>
<odoo>


  <template id="payment_hyperpay_sfa.method_form" inherit_id="payment.method_form">
    <input name="o_payment_radio" position="attributes">
      <attribute name="t-att-data-hyperpay-inline-form-values">
        provider_sudo._hyperpay_get_inline_form_values(pm_sudo.code, amount, currency)
      </attribute>
    </input>
  </template>

  <template id="inline_form">
    <div name="o_hyperpay_component_container" t-att-data-hyperpay-inline-form-values="provider_sudo._hyperpay_get_inline_form_values(pm_sudo.code, amount, currency)">
    </div>
  </template>

</odoo>
